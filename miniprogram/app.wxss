/* ============ 回收站统一卡片样式（catTrash / pageTrash 共用）============ */
/* 覆盖 .container 的卡片布局：列表页贴近顶部、左右留白。
   注意：全局 .container 有 flex 居中布局，回收站页面用 .container-trash 类名覆盖，
   或在 wxml 的 container 上直接用 style 覆盖，具体见各页面 wxml 的 class 选择。 */
.trash-empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 80rpx 0;
}
.trash-item {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.trash-head {
  display: flex;
  flex-direction: column;
}
.trash-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}
.trash-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.trash-detail {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f2f2f2;
}
.trash-photos {
  display: flex;
  flex-wrap: wrap;
}
.trash-photo {
  width: 150rpx;
  height: 150rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 8rpx;
  background: #f2f2f2;
}
.trash-no-photo {
  font-size: 24rpx;
  color: #999;
  padding: 12rpx 0;
}
.trash-restore {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #fff;
  background: #FF405E;
  border-radius: 8rpx;
  line-height: 2.4;
}

/* ============ 推文卡片时间行（pageCard / someBooklet 的 page 模板共用）============
   小红书风：居中、小字号、贴近标题（间隙小）。只在搜索结果等 showTime 场景显示，
   首页瀑布流不显示。时间文案见 utils/sort.js decorateTime。 */
.page-time {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: #aaa;
  line-height: 1;
  margin: 2rpx 0 8rpx;
}

