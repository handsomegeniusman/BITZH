/**app.wxss**/

/* ============ 设计令牌（全站统一的主色 / 文本色 / 布局宽度）============
   主色 #FF405E 粉系白净风；宽屏（平板/电脑）内容列限宽居中。
   页面 wxss 统一用 var(--color-*)；个别低版本真机若不支持 CSS 变量，
   可局部降级为对应 hex（计划里已按"推荐 var、兜底 hex"处理）。 */
page {
  --color-primary: #FF405E;        /* 主色：粉 */
  --color-primary-active: #E63A57; /* 主色按压态 */
  --color-primary-bg: #FFE5EA;     /* 主色浅底 */
  --color-primary-text: #FF405E;   /* 主色深文字 */
  --color-bg: #f5f6f8;             /* 页面底色 */
  --color-card: #fff;              /* 卡片底色 */
  --color-text: #1a1a1a;           /* 主文字 */
  --color-text-sub: #666;          /* 次级文字 */
  --color-text-muted: #999;        /* 弱化文字 */
  --color-line: #eee;              /* 分割线 */
  --page-max-width: 720px;         /* 宽屏内容列最大宽度 */
  background-color: var(--color-bg);
}

/* ============ 全局弹窗（黑名单"请离开" / 公告）============
   多个页面（index / catSearch / about / mydetail）共用，
   页面级 wxss 不跨页生效，因此放在全局 app.wxss 中。 */
.popup-background {
  position: fixed;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 999;
}
.popup {
  position: fixed;
  background-color: white;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  border-radius: 20rpx;
  padding: 40rpx;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: fadeIn 0.3s ease;
}
@keyframes fadeIn {
  0% {
    opacity: 0;
    transform: translateY(-40rpx);
  }
  100% {
    opacity: 1;
  }
}
.title1 {
  font-size: 45rpx;
  text-align: center;
  margin-top: 0rpx;
  margin-bottom: 14rpx;
  font-weight: bold;
}
.notice_content {
  font-size: 32rpx;
  margin-top: 40rpx;
  text-align: justify;
}
.close-button {
  background-color: #FF405E;
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
  margin-top: 30rpx;
}

