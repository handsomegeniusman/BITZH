/* ============================================================
   猫咪关系编辑器样式
   （卡片尺寸与 catDetail 页相关猫咪保持一致）
============================================================ */

/* ---------- 卡片区 ---------- */
.rel-wrap {
  padding: 16rpx 0;
  background: #fff;
}
.rel-row {
  display: flex;
  align-items: flex-start;
}
/* 固定在最左侧的添加按钮（不随卡片滑动） */
.rel-add {
  flex-shrink: 0;
  width: 128rpx;
  padding-top: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}
.rel-add-symbol {
  width: 90rpx;
  height: 90rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 56rpx;
  font-weight: 200;
  color: #FF405E;
  background: #fff7ee;
  border: 2rpx dashed #ffb75e;
  border-radius: 16rpx;
  box-sizing: border-box;
}
.rel-add-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #FF405E;
}
.rel-scroll {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
}
.rel-cards {
  display: inline-flex;
  padding: 10rpx 16rpx 10rpx 0;
}
.rel-card {
  flex-shrink: 0;
  width: 185rpx;
  display: inline-block;
  box-sizing: border-box;
  margin-right: 12rpx;
  text-align: center;
  padding: 10rpx 0;
}
.rel-avatar-wrap {
  position: relative;
  text-align: center;
}
.rel-avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 12rpx;
}
.rel-missing-badge {
  position: absolute;
  left: 50%;
  bottom: -4rpx;
  transform: translateX(-50%);
  padding: 0 10rpx;
  font-size: 18rpx;
  line-height: 1.6;
  color: #fff;
  background: #999;
  border-radius: 8rpx;
  white-space: nowrap;
}
.rel-card-missing .rel-avatar {
  opacity: 0.45;
}
.rel-card-missing .rel-name {
  color: #999;
}
.rel-name {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #000;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.rel-relation {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #474747;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.rel-empty {
  display: inline-block;
  font-size: 22rpx;
  color: #bbb;
  line-height: 120rpx;
  margin-left: 20rpx;
}

/* ---------- 弹窗通用：遮罩 + 底部半屏 ---------- */
.rel-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
}
.rel-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 82vh;
  overflow-y: auto;
}
.rel-sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
}
.rel-sheet-btns {
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
}
.rel-sheet-btn {
  flex: 1;
  margin: 0 8rpx;
  font-size: 28rpx;
  border-radius: 10rpx;
  line-height: 2.4;
}
.rel-sheet-btn:first-child {
  margin-left: 0;
}
.rel-sheet-btn:last-child {
  margin-right: 0;
}
.rel-sheet-btn.cancel {
  background: #f2f2f2;
  color: #333;
}
.rel-sheet-btn.ok {
  background: #FF405E;
  color: #fff;
}
.rel-sheet-btn.warn {
  background: #f7a13a;
  color: #fff;
}
.rel-sheet-btn.danger {
  background: #fa5151;
  color: #fff;
}

/* ---------- 搜索弹窗 ---------- */
/* 搜索弹窗用纵向 flex：标题/搜索框/暂存/取消固定，结果列表自适应收缩，
   键盘弹出导致弹窗变矮时按钮仍可见（不会滚到屏幕外） */
.rel-sheet-search {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.rel-search-box {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}
.rel-search-input {
  height: 76rpx;
  font-size: 28rpx;
}
.rel-search-list {
  flex: 1;
  min-height: 0;
  /* 兜底上限：列表最高约半屏，超出部分内部滚动；保证列表永远在「暂存」按钮上方结束，
     不会因父容器 auto 高度不收缩而无限长盖住 暂存/取消 按钮（真机上 scroll-view 在
     height:auto + max-height 的 flex 里可能不收缩，必须给个硬上限才可靠） */
  max-height: 45vh;
  padding-bottom: 8rpx; /* 最后一项与下方边界线之间留点空隙 */
}
/* 底部固定区：边界线在「暂存」按钮上方；键盘弹出弹窗变矮时也固定可见，不随列表滚动 */
.rel-search-footer {
  flex-shrink: 0;
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f0f0f0; /* 可见边界：搜索结果列表到此为止 */
}
.rel-search-item {
  display: flex;
  align-items: center;
  padding: 16rpx 8rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.rel-search-item:active {
  background: #f7f7f7;
}
.rel-search-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
}
.rel-search-info {
  margin-left: 20rpx;
  overflow: hidden;
}
.rel-search-name {
  font-size: 28rpx;
  color: #222;
}
.rel-search-loc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.rel-tip {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 30rpx 0 10rpx;
}
.rel-no-result {
  padding: 30rpx 0 10rpx;
  text-align: center;
}
.rel-no-result-text {
  font-size: 26rpx;
  color: #888;
}
.rel-keep-btn {
  margin-top: 12rpx;
  width: 100%;
  font-size: 26rpx;
  background: #fff7ee;
  color: #FF405E;
  border-radius: 10rpx;
  flex-shrink: 0;
}
.rel-keep-btn:active {
  background: #ffe4c9;
}

/* ---------- 填关系弹窗 ---------- */
.rel-target {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}
.rel-target-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
}
.rel-target-name {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}
.rel-target-missing {
  font-size: 22rpx;
  color: #999;
  font-weight: 400;
}
.rel-relation-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}
.rel-relation-input-row {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
}
.rel-relation-input {
  height: 76rpx;
  font-size: 28rpx;
}
.rel-chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.rel-chip {
  padding: 6rpx 22rpx;
  margin: 0 12rpx 12rpx 0;
  font-size: 24rpx;
  color: #333;
  background: #f0f0f0;
  border-radius: 999rpx;
}
.rel-chip:active {
  background: #ffe4c9;
  color: #FF405E;
}

/* ---------- 同步确认弹窗 ---------- */
.rel-sync-summary {
  font-size: 28rpx;
  color: #333;
  text-align: center;
  margin-bottom: 24rpx;
}
.rel-em {
  color: #FF405E;
  font-weight: 600;
}
.rel-sync-inverse {
  margin-top: 8rpx;
}
.rel-sync-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}
.rel-noask {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
}
.rel-check {
  font-size: 32rpx;
  color: #ccc;
  margin-right: 8rpx;
}
.rel-check.on {
  color: #FF405E;
}
.rel-noask-text {
  font-size: 26rpx;
  color: #666;
}

/* ---------- 删除确认弹窗 ---------- */
.rel-delete-hint {
  text-align: center;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}
