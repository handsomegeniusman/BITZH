<!-- 自定义底部导航：4 tab + 中间凸起加号。
     加号用 catchtap 拦截，不参与 switchTab；点击进入发帖页。 -->
<view class="tab-bar">
  <view class="tab-bar-item" data-path="/pages/catSearch/catSearch" bindtap="switchTab">
    <view class="tab-text {{selected === 0 ? 'active' : ''}}">查猫</view>
  </view>
  <view class="tab-bar-item" data-path="/pages/index/index" bindtap="switchTab">
    <view class="tab-text {{selected === 1 ? 'active' : ''}}">小猫书</view>
  </view>
  <!-- 加号只在「发布开关开着」且「当前用户有发布权」时出现（管理员，或申请获批的普通用户）。
       两个条件都在 js 的 refreshAudit() 里算好，这里只认结果。 -->
  <view class="tab-bar-center" catchtap="addPost" wx:if="{{audit && canPublish}}">
    <view class="add-btn">＋</view>
  </view>
  <view class="tab-bar-item" data-path="/pages/about/about" bindtap="switchTab">
    <view class="tab-text {{selected === 2 ? 'active' : ''}}">关于</view>
  </view>
  <view class="tab-bar-item" data-path="/pages/mydetail/mydetail" bindtap="switchTab">
    <view class="tab-text {{selected === 3 ? 'active' : ''}}">我的</view>
  </view>
</view>
