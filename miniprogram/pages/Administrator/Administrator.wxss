.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: linear-gradient(180deg, #fff5f8 0%, #ffeef4 100%);
  padding: 24rpx;
  box-sizing: border-box;
}
.page {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.title {
  font-size: 50rpx;
  color: #80244d;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-top: 140rpx;
  margin-bottom: 20rpx;
}

/* 分组区 */
.section {
  width: 100%;
  margin-bottom: 30rpx;
}
.section-title {
  display: block;
  font-size: 26rpx;
  color: #b08498;
  letter-spacing: 2rpx;
  margin: 10rpx 8rpx 16rpx;
}

/* 表单类卡片（开关 / 联系方式） */
.card {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 30rpx 28rpx;
  box-shadow: 0 8rpx 22rpx rgba(160, 90, 120, 0.08);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.feature-title {
  font-size: 30rpx;
  color: #6b2140;
  font-weight: 600;
}
.card-desc {
  font-size: 24rpx;
  color: #b08498;
  line-height: 1.5;
}
.badge {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}
.badge-on {
  color: #1f7a3d;
  background: #e5f6ea;
}
.badge-off {
  color: #9c6b7e;
  background: #f4e9ee;
}
.feature-button {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0;
  padding: 0;
  background: linear-gradient(90deg, #FF8FA3 0%, #E63A57 100%);
  color: #fff;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(255, 128, 178, 0.28);
}
.feature-button::after {
  border: none;
}
.feature-button:active {
  opacity: 0.9;
}
.contact-input {
  width: 100%;
  height: 84rpx;
  background: #f7f2f4;
  border-radius: 12rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #6b2140;
}
/* 联系方式卡片：标题行可点击，右侧箭头指示展开状态 */
.contact-toggle {
  font-size: 44rpx;
  color: #c9aab6;
  line-height: 1;
  transition: transform 0.2s ease;
}
.contact-toggle-open {
  transform: rotate(90deg);
}
.contact-placeholder {
  color: #c9aab6;
}

/* 说明行：卡片底部的小字（密码存哪、词库加完要等多久之类）。
   用比 .card-desc 更小更淡的字：它是"备注"，不是要读的内容。 */
.pwd-tip {
  font-size: 22rpx;
  color: #b08498;
  line-height: 1.6;
}

/* 一行里左边说明、右边一个操作。用于「审核开关」——
   开关从整行大按钮缩成右侧一个小按钮后，说明文字与它同一行。 */
.card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

/* ---------- 审核开关的小按钮 ----------
   ⚠️ 刻意**不复用** .feature-button：那个类是 88rpx 高的全宽主色渐变按钮，
      和「保存联系方式」等长表单提交按钮共用。审核开关只是"开/关一个开关"，
      占一整行会让人以为它比用户管理还重要。改这里不会影响别处。 */
.toggle-mini {
  flex-shrink: 0;
  padding: 14rpx 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(90deg, #FF8FA3 0%, #E63A57 100%);
  border-radius: 999rpx;
  box-shadow: 0 6rpx 16rpx rgba(255, 128, 178, 0.28);
}

.toggle-mini:active {
  opacity: 0.9;
}

/* ---------- 敏感词库 ---------- */
.tier-row {
  display: flex;
  gap: 16rpx;
}

/* 档位选择：两个并排的卡片式单选。把说明写在选项里，
   因为"拦下 / 只标记"这两个词本身说不清后果，选错了才会发现。 */
.tier-chip {
  flex: 1;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #f7f2f4;
  border: 2rpx solid transparent;
}

.tier-chip-on {
  background: #fff0f4;
  border-color: #E63A57;
}

.tier-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #6b2140;
}

.tier-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #b08498;
  line-height: 1.4;
}

/* 词条行：词 + 档位标签 + 删除 */
.word-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #f4e9ee;
}

.word-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #6b2140;
  word-break: break-all;
}

.word-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  color: #9c3a2e;
  background: #fde9e6;
}

/* 「只标记」比「拦下」轻，用灰绿色区分；两者一眼可辨但又都不抢眼 */
.word-tag-review {
  color: #1f7a3d;
  background: #e5f6ea;
}

.word-del {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #c0392b;
  padding: 4rpx 12rpx;
}

/* 行式导航入口 */
.row {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx 28rpx;
  box-shadow: 0 8rpx 22rpx rgba(160, 90, 120, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.row-hover {
  background: #fdf3f6;
}
.row-title {
  font-size: 28rpx;
  color: #6b2140;
  font-weight: 500;
}
.row-arrow {
  font-size: 44rpx;
  color: #c9aab6;
  line-height: 1;
}
.row-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.row-sub {
  font-size: 24rpx;
  color: #b08498;
}

/* 底部留白（页面可滚动） */
.footer-space {
  height: 60rpx;
}

/* small screens tweak */
@media (max-width: 640rpx) {
  .title { font-size: 42rpx; margin-top: 100rpx; }
  .section-title { font-size: 22rpx; }
  .feature-title { font-size: 26rpx; }
  .row-title { font-size: 26rpx; }
}
