<import src="../templates/common.wxml"/>

<view wx:if="{{blackNum}}">
  <template is="blackNumPopup" data="{{popupAnimation}}"/>
</view>
<view wx:else class="about-root">
  <!-- 连点开关在**这个 logo** 上（2026-09-17 从底部那四行挪过来的），
       计数在 about.js 的 staffTap，离开本页清零。连点 5 次后按「注册没注册」分流成两条：
         · 已注册 → 开通审核模式豁免（Feeder.enable = true）。**真正写库的是 postApply
           云函数**的 selfEnable（身份服务端派生，所以开不了别人），开通后往
           「发布申请」群推一条通知。
         · 未注册 → 只临时开放**注册入口**（内存态，不写库、不走云函数、无通知）。
       **两条都不给发帖权** —— 发帖权（canPost）只能由管理员审批授予。
       ⚠️ 长按（bindlongpress）与连点是两件事，**不要合并**：长按是管理员进后台，
          与"谁是注册用户"无关。两者在同一个元素上共存，但"不冲突"**不靠微信的事件语义** ——
          edit() 会记一个时间戳，staffTap() 用 800ms 窗口把紧跟长按的那次 tap 吃掉。
          详见 about.js 的 staffTap / edit 两段注释。 -->
  <view class="about-logo-wrap" bindtap="staffTap" bindlongpress="edit">
    <image class="about-logo" mode="widthFix" src="/pages/images/logo.png">
    </image>
  </view>

  <text> \n </text>

  <view class="head1">简介</view>

  <view class="body">
    北理珠流浪猫关爱部：由北京理工大学珠海学院学生发起的猫咪群护志愿组织，负责照顾北京理工大学珠海学院的流浪猫，主要进行喂食、绝育与送养等工作。
  </view>

  <view class="head1">联系方式</view>
  <view class="body">
    微信、手机号：<text bindtap="copyTBL" class="copy" hover-class="copy-active">{{phone}}</text>
  </view>
  <view class="body">
    邮箱：<text bindtap="copyTBL1" class="copy" hover-class="copy-active">{{email}}</text>
  </view>
  <view class="body">
    公众号：<text bindtap="previewQR1" class="copy"> 金凤路6号流浪猫关爱部</text>
    <image class="erweima-img" src="/pages/images/toweima.jpg"></image>
  </view>

  <view class="head1">关于周边</view>
  <view class="body">
    <view class="qr-click-wrap" bindtap="copyTBL6">
      <text class="copy">点击并扫描二维码可跳转</text>
      <image class="erweima-img" src="/pages/images/toweima.jpg"></image>
    </view>
  </view>

  <view class="head1">关于赞助</view>
  <view class="body">
    可点击
    <text bindtap="showVideo" class="copy">按钮</text>
    观看广告，也可点击
    <view class="qr-click-wrap" bindtap="previewQR2">
      <text  class="copy">二维码</text>
      <image class="erweima-img" src="/pages/images/toweima.jpg"></image>
    </view>
    向财务进行赞助
  </view>

  <view class="head1">关于校外猫咪</view>
  <view class="body">
    学校不接收外来弃养猫咪
  </view>

  <view class="head1">关于收入</view>
  <view class="body">
    此小程序内的所有利润，将全部交由
    <view class="qr-click-wrap" bindtap="previewQR1">
      <text class="copy">金凤路6号流浪猫关爱部</text>
      <image class="erweima-img" src="/pages/images/toweima.jpg"></image>
    </view>
    公众号管理者使用，用于对校内流浪猫进行救治、绝育等，详情请在
    <view class="qr-click-wrap" bindtap="previewQR1">
      <text class="copy">金凤路6号流浪猫关爱部</text>
      <image class="erweima-img" src="/pages/images/toweima.jpg"></image>
    </view>
    的财务公示进行查看
  </view>

  <view class="head1">特别鸣谢</view>

  <!-- 原项目致敬：保留北大猫协开源项目链接，不删除 -->
  <view class="body">
    本小程序基于<text bindtap="copyWechat" class="copy" hover-class="copy-active">北大猫协</text>的开源项目二次开发，原项目配有教学视频，学习使用，
    点击<text bindtap="copyTBL4" class="copy" hover-class="copy-active">复制原项目链接</text>并在浏览器进入，致敬原项目作者与万柳猫猫之家。
  </view>

  <!-- 本项目开源：作者自己的 GitHub / Gitee -->
  <view class="body">
    本项目代码全部开源（MIT 协议），可点击
    <text bindtap="copyGithub" class="copy" hover-class="copy-active">复制 GitHub 链接</text>
    /
    <text bindtap="copyGitee" class="copy" hover-class="copy-active">复制 Gitee 链接</text>
    查看源码，欢迎学习与二开使用。
  </view>

  <text> \n </text>



  <view class="itemname1">
    <view class="navi-mini-wrap" bindtap="naviToMini">
      <image class="navi-mini-icon" src="/pages/images/circle.png"></image>
      <view class="navi-mini-text"> \n 高校动保索引 </view>
    </view>
  </view>



  <text> \n </text>
  <!-- 底部四行只是署名，**没有点击行为**（连点开关已挪到顶部 logo，见上方注释）。
       2026-09-17 之前这里是连点区，挪走的原因是需求方说的入口就是 logo，
       而"两处都能点"会让计数被拆到两个地方，人更不容易凑满 5 次。 -->
  <view class="staff">
    小程序开发： 北理珠流浪猫关爱部
  </view>
  <view class="staff">
    信息整理： 北理珠流浪猫关爱部
  </view>
  <view class="staff">
    logo制作： 梨压梨
  </view>
  <view class="staff">
    v6.6.6
  </view>

</view>
