<!--pages/addBooklet/addBooklet.wxml-->
<view class="img-tip">{{imgTip}}</view>
<scroll-view class="image-swiper" scroll-x="{{!drag.active}}" scroll-y="false">
  <view class="image-track" style="width: {{(tempFileList.length + 1) * drag.step}}px">
    <!-- 每张图片：绝对定位，靠 translateX 排位；长按进入拖拽后跟手、邻居带动画让位 -->
    <view
      class="image-item"
      wx:for="{{tempFileList}}"
      wx:key="tempFilePath"
      data-index="{{index}}"
      style="transform: translateX({{index * drag.step + (index === drag.index ? drag.offsetX : 0)}}px){{index === drag.index && drag.active ? ' scale(1.06)' : ''}}; transition: {{drag.active && index === drag.index ? 'none' : 'transform .2s ease'}}; z-index: {{index === drag.index ? 99 : 1}};{{index === drag.index && drag.active ? ' opacity:.85' : ''}}"
      bindtouchstart="onImgTouchStart"
      bindtouchmove="onImgTouchMove"
      bindtouchend="onImgTouchEnd"
      bindtouchcancel="onImgTouchEnd"
      bindtap="onImgTap"
    >
      <view class="item-img-box">
        <image class="item-image" src="{{item.tempFilePath}}" mode="aspectFit"/>
        <view class="cover-badge" wx:if="{{index === 0}}">封面</view>
      </view>
      <view class="item-tools">
        <text wx:if="{{index > 0}}" class="tool-btn" catchtap="onSetCover" data-tool="1" data-index="{{index}}">☆ 设封面</text>
        <text wx:else class="tool-btn on">★ 封面</text>
        <image class="delete-icon" src="/pages/images/delete.jpg" catchtap="onDelete" data-tool="1" data-index="{{index}}" mode=""/>
      </view>
    </view>
    <!-- 末尾"+"新增位：只响应点击，不参与拖拽/预览 -->
    <view class="image-item add-item" style="transform: translateX({{tempFileList.length * drag.step}}px)" bindtap="getphoto">
      <view class="item-img-box">
        <image class="item-image" src="/pages/images/addPhoto.png" mode="aspectFit"/>
      </view>
    </view>
  </view>
</scroll-view>
<view class="img-count">已选 {{tempFileList.length}} 张</view>

<view class="head1">
  <text user-select="true">标题名称</text><text class="req-star">*</text>
</view>
<input data-key='tittle' bindinput="inputText" class="edit-input {{formErrors.tittle ? 'input-error' : ''}}" value="{{listData.tittle}}" placeholder="填写标题" />
<view class="field-error" wx:if="{{formErrors.tittle}}">标题为必填项，请填写</view>
<view class="head1">
  <text user-select="true">内容</text>
</view>
<textarea data-key='main' bindinput="inputText" maxlength="2000" class="edit-input-main" value="{{listData.main}}" placeholder="添加正文" 	auto-height="true"></textarea>
<view class="head1">
  <text user-select="true">话题</text>
</view>
<topic-editor id="topicEditor" value="{{listData.relative || ''}}" bind:change="onTopicChange"></topic-editor>
<view class="head1">
  <text user-select="true">拍摄时间</text>
</view>
<picker mode="date" data-key='photoTime' bindchange="bindDateChange" value="{{listData.photoTime || todayStr}}" start="2015-01-01" end="{{todayStr}}">
  <view class="edit-input picker-field">
    <text class="picker-value {{listData.photoTime ? '' : 'picker-empty'}}">{{listData.photoTime || '拍摄于哪天？（选填）'}}</text>
    <text class="picker-arrow">▾</text>
  </view>
</picker>
<view class="field-tip">已默认今天 · 点击可修改 · 不能选未来日期</view>

<view class="bottom-pad"></view>

<!-- 删除图片确认弹窗（勾选"下次不再询问"后直接删，不再弹窗） -->
<view class="del-mask" wx:if="{{delModal.show}}" catchtouchmove="noop" bindtap="delCancel">
  <view class="del-modal" catchtap="noop">
    <view class="del-title">删除这张图片？</view>
    <view class="del-option" catchtap="toggleNoAsk">
      <text class="del-check {{delModal.noAsk ? 'on' : ''}}">{{delModal.noAsk ? '☑' : '☐'}}</text>
      <text class="del-option-text">下次不再询问</text>
    </view>
    <view class="del-btns">
      <button class="del-btn cancel" bindtap="delCancel">取消</button>
      <button class="del-btn ok" bindtap="delConfirm">删除</button>
    </view>
  </view>
</view>

<!-- 吸底按钮条：发布 -->
<view class="bottom-bar">
  <button bindtap="confirm" class="bar-btn reset-margin">发布</button>
</view>
