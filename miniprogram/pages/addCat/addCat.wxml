<view class="bottom-pad"></view>

<!-- 删除图片确认弹窗（勾选"下次不再询问"后直接删，不再弹窗） -->
<view class="del-mask" wx:if="{{delModal.show}}" catchtouchmove="noop" bindtap="delCancel">
  <view class="del-modal" catchtap="noop">
    <view class="del-title">删除这张图片？</view>
    <view class="del-option" catchtap="toggleNoAsk">
      <text class="del-check {{delModal.noAsk ? 'on' : ''}}">{{delModal.noAsk ? '☑' : '☐'}}</text>
      <text class="del-option-text">下次不再询问</text>
    </view>
    <view class="del-btns">
      <button class="del-btn cancel" bindtap="delCancel">取消</button>
      <button class="del-btn ok" bindtap="delConfirm">删除</button>
    </view>
  </view>
</view>

<!-- 发现同名删除记录：询问是否用上次删除的数据（自定义弹层，不用 wx.showModal，避开 bindblur 弹窗被吞） -->
<view class="del-mask" wx:if="{{deletedAsk.show}}" catchtouchmove="noop" bindtap="hideDeletedAsk">
  <view class="del-modal" catchtap="noop">
    <view class="del-title">发现同名删除记录</view>
    <view class="restore-content">「{{deletedAsk.name}}」曾在 {{deletedAsk.time}} 被删除</view>
    <view class="restore-content">是否将上次删除的数据填入表单？</view>
    <!-- hasPhotos：存档里带了"当时的照片清单"，确认后会连照片一起填回图片区 -->
    <view class="restore-content" wx:if="{{deletedAsk.hasPhotos}}">含当时照片，将一并填回图片区</view>
    <view class="del-btns">
      <button class="del-btn cancel" bindtap="hideDeletedAsk">忽略</button>
      <button class="del-btn restore-btn-ok" bindtap="confirmDeletedAsk">使用上次数据</button>
    </view>
  </view>
</view>

<!-- 吸底按钮条：确定提交 -->
<view class="bottom-bar">
  <button class="bar-btn primary reset-margin" bindtap="upload">确定提交</button>
</view>