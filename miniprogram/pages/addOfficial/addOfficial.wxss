/* pages/addOfficial/addOfficial.wxss —— 官方推文发布页（表单样式与 addBooklet 一致） */

/* ===================== 图片区：提示文案 + 计数 ===================== */
.img-tip {
  font-size: 22rpx;
  color: #999;
  padding: 4rpx 20rpx 0;
}
.img-count {
  font-size: 22rpx;
  color: #999;
  padding: 0 20rpx 10rpx;
}

/* ===================== 图片区：横向滚动轨道 ===================== */
.image-swiper {
  overflow-x: scroll;
  overflow-y: hidden;
  padding: 10px 0;
  height: 226px; /* 图 180px + 工具行 30px + 留白 */
}
.image-track {
  position: relative;
  height: 226px;
}
.image-item {
  position: absolute;
  left: 0;
  top: 0;
  width: 180px;
  text-align: center;
  will-change: transform;
}
.item-img-box {
  position: relative;
  width: 180px;
  height: 180px;
  background: #f3f3f3;
}
.item-image {
  width: 100%;
  height: 100%;
}

/* 封面角标：挂在第一张图上，设为封面后自动跟随（首图作为小猫书列表缩略图） */
.cover-badge {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  z-index: 5;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(255, 80, 60, 0.9);
  color: #fff;
  font-size: 20rpx;
  line-height: 1.5;
}

/* 工具行：设封面 + 删除角标，两端对齐 */
.item-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 30px;
  padding: 2rpx 6rpx;
  box-sizing: border-box;
}
.tool-btn {
  font-size: 22rpx;
  color: #FF8A2A; /* 设封面提示钮：深橙（功能色，区别于主粉 #FF405E / 警示红） */
  padding: 0 4rpx;
}
.tool-btn.on {
  color: #FF405E;
}
.delete-icon {
  position: relative;
  width: 16px;
  height: 16px;
  padding: 4rpx;
}

/* ===================== 删除图片确认弹窗 ===================== */
.del-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}
.del-modal {
  width: 560rpx;
  box-sizing: border-box;
  padding: 36rpx 32rpx 28rpx;
  background: #fff;
  border-radius: 16rpx;
}
.del-title {
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
}
.del-option {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}
.del-check {
  font-size: 32rpx;
  color: #ccc;
  margin-right: 8rpx;
}
.del-check.on {
  color: #FF405E;
}
.del-option-text {
  font-size: 26rpx;
  color: #666;
}
.del-btns {
  display: flex;
  justify-content: space-between;
}
.del-btn {
  width: 220rpx;
  margin: 0;
  font-size: 28rpx;
  border-radius: 8rpx;
}
.del-btn.cancel {
  background: #f2f2f2;
  color: #333;
}
.del-btn.ok {
  background: #fa5151;
  color: #fff;
}

/* ===================== 吸底按钮条 ===================== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.06);
}
.bar-btn {
  flex: 1;
  margin: 0 12rpx;
  font-size: 30rpx;
  border-radius: 20rpx;
  background-color: #FF405E;
  color: #fff;
}
/* 页面底部留白，避免吸底条遮挡表单最后一项 */
.bottom-pad {
  height: calc(220rpx + env(safe-area-inset-bottom));
}

/* ===================== 表单 ===================== */
.edit-input {
  display: block;
  height: 60rpx;
  font-size: 31rpx;
  margin-left: 40rpx;
  margin-right: 40rpx;
  margin-bottom: 10rpx;
  background: none;
  border: none;
  border-bottom: 1px solid #DFDFDF;
  color: #333333;
  /* width: 100%; */
  margin-top: 10rpx;
}
.edit-input-main {
  display: block;
  height: 60rpx;
  font-size: 31rpx;
  margin-left: 40rpx;
  margin-right: 40rpx;
  margin-top: 25rpx;
  margin-bottom: 50rpx;
  background: none;
  border: none;
  border-bottom: 1px solid #DFDFDF;
  color: #333333;
  width: calc(100% - 80rpx); /* 原 90% + 左右 40rpx 边距 = 755rpx，溢出屏幕 5rpx */

}
.reset-margin {
  margin: 0;
}

/* ===================== 必填星号 + 校验红框 + 错误提示 ===================== */
/* 必填字段旁边的红星标注 */
.req-star {
  margin-left: 6rpx;
  color: #e64340;
  font-size: 32rpx;
  line-height: 1;
}
/* 必填项未填时输入框变红（提交时触发） */
.input-error {
  border-bottom-color: #e64340 !important;
  color: #e64340 !important;
  background: rgba(255, 77, 66, 0.04);
}
/* 输入框下方的错误提示文字 */
.field-error {
  margin-top: 6rpx;
  margin-bottom: 6rpx;
  font-size: 24rpx;
  color: #e64340;
  line-height: 1.6;
}

/* ===================== 拍摄时间（日期选择器字段） ===================== */
/* 下拉字段：日期值在左、箭头在右，一眼可点 */
.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.picker-value {
  color: #333333; /* 与 .edit-input 默认文字色一致 */
}
.picker-empty {
  color: #bbb; /* 空值时的占位提示色 */
}
.picker-arrow {
  color: #bbb;
  font-size: 26rpx;
}
/* 字段下方的小字提示（说明默认今天 / 不可选未来） */
.field-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #aaa;
  line-height: 1.6;
}

/* ===================== 小红书式白卡片表单 ===================== */
.form-card {
  margin: 24rpx 24rpx 16rpx;
  padding: 8rpx 32rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
  transition: margin-top 0.3s ease-out;
}
/* 聚焦输入时图片区缩小，白卡片上移并收紧与图片区的空隙（避免留一大块空白） */
.form-card.is-compact {
  margin-top: 0;
}
/* 标题行：无下划线输入，下方细分隔线（校验失败变红） */
.title-row {
  border-bottom: 1rpx solid #f0f0f0;
}
.title-row.divider-error {
  border-bottom: 2rpx solid #e64340;
}
.title-input {
  display: block;
  width: 100%;
  height: 92rpx;
  font-size: 38rpx;
  font-weight: 600;
  color: #1a1a1a;
  padding: 0;
  margin: 0;
  background: none;
  border: none;
  box-sizing: border-box;
}
/* 拍摄时间字段行：左标签右值，顶部细分隔线 */
.pt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #f0f0f0;
}
.pt-label {
  font-size: 28rpx;
  color: #666;
}
.pt-value-wrap {
  display: flex;
  align-items: center;
}
.pt-value {
  font-size: 28rpx;
  color: #1a1a1a;
}
.pt-empty {
  color: #bbb;
}
.pt-arrow {
  color: #bbb;
  margin-left: 8rpx;
  font-size: 24rpx;
}
