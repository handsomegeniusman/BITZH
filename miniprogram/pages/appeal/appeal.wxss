.root {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.hint {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
}

.textarea {
  width: 100%;
  height: 220rpx;
  font-size: 26rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.input {
  width: 100%;
  font-size: 26rpx;
  height: 60rpx;
}

.email {
  font-size: 28rpx;
  color: #FF405E;
  word-break: break-all;
}

.tip {
  font-size: 24rpx;
  color: #999;
  margin: 8rpx 4rpx 24rpx;
}

.btn {
  background: #FF405E;
  color: #fff;
  border-radius: 44rpx;
}

.btn[disabled] {
  opacity: 0.6;
  color: #fff;
}
