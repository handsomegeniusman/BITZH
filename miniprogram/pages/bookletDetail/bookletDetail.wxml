<!--pages/bookletDetail/bookletDetail.wxml-->
<!-- 整体内容列：max-width 720px 居中，宽屏（平板/电脑）不拉伸 -->
<view class="page-wrap">

  <!-- 封禁占位：帖子被下架/封禁后，非管理入口打开全屏显示占位，遮住并替代正文 -->
  <view wx:if="{{blocked}}" class="blocked-mask">
    <view class="blocked-icon">🔒</view>
    <view class="blocked-title">该帖子已被封禁</view>
    <view class="blocked-tip">内容因违规已被下架，无法查看</view>
    <button class="blocked-back" bindtap="goBack">返回</button>
  </view>

  <!-- 顶部图片轮播：高度自适应（手机≈屏宽、宽屏由 vh 封顶），不超屏 -->
  <view class="image-container">
    <!-- 回收站预览且无照片存档：占位提示，不渲染空轮播 -->
    <view wx:if="{{recoverMode && imageUrls.length == 0}}" class="no-archive-photo">无照片存档（删除时未保留照片）</view>
    <!-- circular="true"：轮播到头会自动循环（和猫详情页一样），不会滑到最后一张就停住 -->
    <swiper wx:else class="detail-swiper" circular="true" data-_id="{{ listData._id }}" bindchange="bindChange" bindlongpress="editBooklet" data-authorid="{{listData.authorId}}" indicator-dots="{{ true }}" indicator-color="#ffffff" indicator-active-color="#FF405E" current="{{currentImageIndex}}" animation="{{animationData}}">
      <block wx:for="{{imageUrls}}" wx:key="*this">
        <swiper-item>
          <image lazy-load="true" class="item-image" src="{{item}}" mode="aspectFit" bindtap="previewImageHandler"/>
          <view class="showNum">
            <text class="show-num-text">{{index+1}}/{{imageUrls.length}}</text>
          </view>
        </swiper-item>
      </block>
    </swiper>
  </view>

  <!-- 正文卡片 -->
  <view class="content-card">
    <view class="head">
      <!-- 标题是猫名时前面画 🐱（和话题胶囊一致）。标题本身不响应手势：
           长按编辑猫挂在下面的话题胶囊上（管理员），正文仍可长按选中复制。 -->
      <view class="head-title-wrap">
        <text wx:if="{{titleCatId && !titleHasCatIcon}}" class="head-title-cat">🐱</text>
        <view class="head-title">{{listData.tittle}}</view>
      </view>
      <text wx:if="{{!recoverMode}}" class="report-link" bindtap="reportPage">举报</text>
    </view>
    <!-- 拍摄时间：放在标题正下方，不滑动也能看到 -->
    <view wx:if="{{listData.photoTime}}" class="photoTime">拍摄于 {{listData.photoTime}}</view>
    <view class="main" user-select="true">{{listData.main}}</view>

    <!-- 话题：点击跳相关猫咪或话题文章；管理员长按胶囊 → 直达那只猫的编辑页。
         data-_id 由 markCatTopics 一并算好（话题不是猫名时为空，长按不跳） -->
    <view wx:if="{{relativeList.length}}" class="topic-block">
      <view class="relative-tags">
        <view class="relative-chip" wx:for="{{relativeList}}" wx:key="*this"
              bindtap="toRelative"
              bindlongpress="editCat"
              data-name="{{item}}"
              data-_id="{{catTopicMap[item] || ''}}">
          <text wx:if="{{catTopicMap[item]}}" class="relative-cat-icon">🐱</text>
          <text class="relative-chip-text">#{{item}}</text>
        </view>
      </view>
      <view class="relative-guide">点击话题可查看相关猫咪或文章</view>

      <!-- 话题命中的猫：扁平、按猫去重，点进猫详情。
           与上面胶囊的 🐱 共用 markCatTopics 的同一次查询和同一套匹配判断，
           所以「胶囊上有 🐱」和「出现在这个列表里」不会互相矛盾。
           用 navigator 而不是 bindtap + wx.navigateTo：跳转是纯声明式的，
           和其余猫咪列表页（所有 / catSearch）写法一致，也不必在 js 里再写一个跳转函数。
           relatedCats 为空（没有标签命中猫）时整块不渲染 —— 多数推文不该多出一行空标题。 -->
      <view wx:if="{{relatedCats.length}}" class="topic-cats">
        <view class="topic-cats-title">相关猫咪</view>
        <view class="topic-cats-list">
          <navigator wx:for="{{relatedCats}}" wx:key="_id"
                     url="/pages/catDetail/catDetail?_id={{item._id}}">
            <view class="topic-cat">
              <image lazy-load="true" class="topic-cat-avator"
                     src="{{item._thumbFallback == 1 ? item._thumbJpg : (item._thumbFallback > 1 ? '/pages/images/logo.png' : item._thumbUrl)}}"
                     binderror="onCatImgError" data-list="relatedCats" data-index="{{index}}"
                     mode="aspectFill"></image>
              <text class="topic-cat-name">{{item.name}}</text>
            </view>
          </navigator>
        </view>
      </view>
    </view>
  </view>

  <!-- 回收站预览：提示 + 进恢复模式编辑页入口（恢复/彻底删除/返回都在编辑页完成） -->
  <view wx:if="{{recoverMode}}" class="recover-bar">
    <text class="recover-tip">回收站预览：这条推文已被删除，以上是删除前的存档内容。</text>
    <button class="recover-edit-btn" bindtap="editRecover">编辑 / 恢复</button>
  </view>

  <!-- 评论区 -->
  <view wx:if="{{audit && !recoverMode}}" class="comment-section">
    <view class="comment-tittle">评论<text wx:if="{{Comment.length}}" class="comment-count"> {{Comment.length}}</text></view>

    <view wx:if="{{showComment}}" class="empty-comment">
      <view><image src="/pages/images/logo.png" mode="" class="empty-comment-logo"/></view>
      <view class="empty-comment-text">还没有评论，来抢沙发吧～</view>
    </view>

    <view class="comment" wx:for="{{Comment}}" wx:key="myCommentId" bindlongpress="choseComment" data-mycommentid="{{item.myCommentId}}" data-authorid="{{item.authorId}}" data-author="{{item.author}}" data-main="{{item.main}}">
      <view class="comment-img">
        <image lazy-load='true' class='avator' mode='aspectFill' src="{{item.authorImg}}" bindtap="showAuthorImg" data-authorimg="{{item.authorImg}}"></image>
      </view>
      <view class="comment-content">
        <view class="comment-head">
          <text class="comment-name">{{item.author}}</text>
          <text class="comment-time">{{item.commentTime}}</text>
        </view>
        <view class="comment-main">
          <text class="comment-main-text">{{item.main}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部评论输入栏：固定底部 + 安全区 + 宽屏居中（与评论区同级，便于评论区底部留白） -->
  <view wx:if="{{audit && !recoverMode}}" class="view-wrapper">
    <!-- 有发布权（管理员 或 申请获批）：正常输入 + 发送按钮 -->
    <view wx:if="{{canComment}}" class="toComment">
      <textarea data-key='main' bindinput="inputText" show-confirm-bar="{{false}}" class="comment_input" auto-height="true" placeholder-class="comment-placeholder" placeholder="善语结善缘，恶语伤人心" value="{{comment}}"></textarea>
      <button bindtap="addComment" class="new-button">发送</button>
    </view>
    <!-- 已注册但未获批：评论照样能看（上面的列表不受影响），只是不能发。
         给一个 disabled 输入框而不是藏掉整栏 —— 藏掉的话用户会以为"这里本来就没法评论"，
         灰着的框 + 明确文案才说得清"你还差一步"。 -->
    <view wx:elif="{{isFeeder}}" class="toComment">
      <textarea disabled data-key='main' show-confirm-bar="{{false}}" class="comment_input" auto-height="true" placeholder-class="comment-placeholder" placeholder="还没有发布权限，点「我的」申请" value="{{comment}}"></textarea>
    </view>
    <!-- 未注册 -->
    <view wx:else class="toComment">
      <textarea disabled data-key='main' show-confirm-bar="{{false}}" class="comment_input" auto-height="true" placeholder-class="comment-placeholder" placeholder="注册后再评论吧" value="{{comment}}"></textarea>
    </view>
  </view>

<!-- 跟随键盘的「完成」栏：键盘弹起时提供一键收起（部分输入法没有收起键） -->
<kb-done-bar/>
</view>
