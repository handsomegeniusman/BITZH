/* ============================================================
   pages/bookletDetail/bookletDetail.wxss —— 推文详情页（简约白净风）
   【适配】手机 / 平板 / 电脑：
     - 内容列 max-width:720px 居中，宽屏不拉伸成通栏
     - 轮播图高度用 100vw + max-height:62vh 双约束：手机≈屏宽，
       宽屏被 vh 封顶，不会变成"摩天楼"
     - 字号/间距用 px（随窗口宽度稳定），避免宽屏下 rpx 被放大
     - 底部输入栏 env(safe-area-inset-bottom) 适配底部安全区
   ============================================================ */

/* ---------- 整体布局：内容列居中，宽屏不拉伸 ---------- */
.page-wrap {
  max-width: 720px;
  margin: 0 auto;
  width: 100%;
  box-sizing: border-box;
  min-height: 100vh; /* 撑满一屏，底栏贴底观感一致 */
}

/* ---------- 顶部图片轮播 ---------- */
.image-container {
  background: #fff;
}
/* 高度自适应：手机（窄屏）≈ 屏宽，宽屏（平板/电脑）由 vh 封顶 */
.detail-swiper {
  width: 100%;
  height: 100vw;
  max-height: 62vh;
  min-height: 300px;
  display: block;
  box-sizing: border-box;
}
.item-image {
  width: 100%;
  height: 100%;
}
/* 页码：图片右下角半透明小胶囊 */
.showNum {
  position: absolute;
  bottom: 12px;
  right: 12px;
  padding: 4px 12px;
  background-color: rgba(0, 0, 0, 0.45);
  border-radius: 999px;
}
.show-num-text {
  color: #fff;
  font-size: 12px;
}
/* 回收站预览：无照片存档占位（与轮播同高） */
.no-archive-photo {
  height: 100vw;
  max-height: 62vh;
  min-height: 300px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7f8fa;
  color: #b0b3bb;
  font-size: 14px;
}

/* ---------- 正文卡片 ---------- */
.content-card {
  background: #fff;
  padding: 24px 20px 28px;
  box-sizing: border-box;
}
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 20px;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.5;
  letter-spacing: 0.5px;
}
.head-title {
  flex: 1;
  min-width: 0;
}
.report-link {
  flex-shrink: 0;
  font-size: 13px;
  font-weight: 400;
  color: #999;
  padding: 4rpx 8rpx;
}
.main {
  margin-top: 16px;
  font-size: 15px;
  color: #333;
  line-height: 1.8;
  word-break: break-all;
  white-space: pre-wrap;
}

/* ---------- 话题区 ---------- */
.topic-block {
  margin-top: 20px;
}
.relative-tags {
  display: flex;
  flex-wrap: wrap;
}
.relative-chip {
  display: inline-flex;
  align-items: center; /* 🐱 与文字垂直居中：emoji 自带基线下沉，基线对齐会显得偏下 */
  margin: 0 8px 8px 0;
  padding: 5px 14px;
  background: #FFE5EA;
  color: #FF405E;
  font-size: 13px;
  border-radius: 999px;
  line-height: 1.5;
  max-width: 200px;
}
.relative-chip:active {
  background: #FFE5EA;
}
/* 话题文字：长话题省略号。省略号逻辑放在文字子元素上（flex 容器本身不做 text-overflow） */
.relative-chip-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.relative-guide {
  margin-top: 4px;
  font-size: 12px;
  color: #999;
}
/* 猫话题前的小猫头标识（和 catDetail 话题一致：真实名/别名/曾用名命中的猫名）。
   胶囊是 inline-flex + align-items:center，图标不参与文字基线，垂直居中 */
.relative-cat-icon {
  flex-shrink: 0;
  margin-right: 2px;
  font-size: 13px;
  line-height: 1;
}

/* ---------- 拍摄时间（标题下方的元信息行） ---------- */
.photoTime {
  margin-top: 8px;
  font-size: 13px;
  color: #999;
}

/* ---------- 回收站预览条 ---------- */
.recover-bar {
  margin: 0 20px 16px;
  padding: 14px 16px;
  background: #FFE5EA;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.recover-tip {
  flex: 1;
  min-width: 0;
  font-size: 13px;
  color: #FF405E;
  line-height: 1.6;
}
.recover-edit-btn {
  flex: none;
  margin-left: 12px;
  background: #FF405E;
  color: #fff;
  font-size: 13px;
  line-height: 34px;
  height: 34px;
  padding: 0 18px;
  border-radius: 17px;
  border: none;
}
.recover-edit-btn::after {
  border: none;
}

/* ---------- 评论区 ---------- */
.comment-section {
  background: #fff;
  border-top: 10px solid #f5f5f5; /* 与正文区之间的细分隔带 */
  padding: 0 20px;
  padding-bottom: calc(88px + env(safe-area-inset-bottom)); /* 给底部输入栏留空间 */
  box-sizing: border-box;
}
.comment-tittle {
  font-size: 17px;
  font-weight: 700;
  color: #1a1a1a;
  padding: 18px 0 8px;
  border-bottom: 1px solid #f2f2f2;
}
.comment-count {
  font-size: 14px;
  color: #999;
  font-weight: 400;
}

/* 无评论空态 */
.empty-comment {
  text-align: center;
  padding: 36px 0 16px;
}
.empty-comment-logo {
  width: 90px;
  height: 60px;
}
.empty-comment-text {
  margin-top: 12px;
  font-size: 14px;
  color: #999;
}

/* 单条评论：头像 + 内容（名字/时间一行，正文换行） */
.comment {
  display: flex;
  align-items: flex-start;
  padding: 16px 0;
  border-bottom: 1px solid #f2f2f2;
}
.comment-img {
  flex: none;
  margin-right: 12px;
}
.avator {
  width: 40px;
  height: 40px;
  border-radius: 50%; /* 圆形头像 */
}
.comment-content {
  flex: 1;
  min-width: 0;
}
.comment-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.comment-name {
  font-size: 14px;
  font-weight: 500;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.comment-time {
  flex: none;
  margin-left: 12px;
  font-size: 12px;
  color: #999;
}
.comment-main {
  margin-top: 6px;
}
.comment-main-text {
  display: inline-block;
  width: 100%;
  font-size: 15px;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

/* ---------- 底部评论输入栏：固定底部 + 安全区 + 宽屏居中 ---------- */
.view-wrapper {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  top: auto;
  max-width: 720px;
  margin: 0 auto; /* 宽屏（平板/电脑）居中，与内容列对齐 */
  z-index: 100;
  display: flex;
  align-items: center;
  width: 100%;
  background: #fff;
  border-top: 1px solid #eee;
  padding: 8px 12px;
  padding-bottom: calc(8px + env(safe-area-inset-bottom)); /* 底部安全区 */
  box-sizing: border-box;
  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.04);
}
.toComment {
  display: flex;
  align-items: center;
  width: 100%;
}
.comment_input {
  flex: 1;
  min-width: 0;
  min-height: 36px;
  max-height: 72px; /* 超高内部滚动，不撑高底栏 */
  padding: 6px 14px;
  margin-left: 4px;
  font-size: 14px;
  line-height: 24px; /* 6 + 24 + 6 = 36 = min-height：单行/占位文字精确垂直居中 */
  background: #f5f5f5;
  border-radius: 18px;
  box-sizing: border-box;
}
/* 占位文字垂直居中兜底（原生 textarea 的 placeholder 渲染），与正文行高一致 */
.comment-placeholder {
  line-height: 24px;
}
.new-button {
  flex: none;
  width: 60px;
  height: 36px;
  margin: 0 2px 0 10px;
  background-color: #FF405E;
  color: #fff;
  padding: 0;
  border: none;
  border-radius: 18px;
  font-size: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-sizing: border-box;
}
.new-button::after {
  border: none;
}
.new-button:active {
  background: #E63A57;
}
