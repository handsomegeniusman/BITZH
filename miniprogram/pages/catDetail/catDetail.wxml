<view wx:if="{{showDetail}}">
  <view wx:if="{{relatedCatsId}}" class="itemname3">
    <scroll-view class="itemname3" scroll-x="true" enable-flex>
      <view wx:for="{{relatedCatsId}}" wx:key="_id" data-_id="{{item._id}}" bindlongpress="editCat" class="related-cat-item">
        <navigator url="/pages/catDetail/catDetail?_id={{item._id}}">
          <view class="related-cat-avatar-wrap" data-_id="{{item._id}}">
            <image lazy-load="true" class="related-cat-avatar" src="{{item._thumbFallback == 1 ? item._thumbJpg : (item._thumbFallback > 1 ? '/pages/images/logo.png' : item._thumbUrl)}}" binderror="onCatImgError" data-list="relatedCatsId" data-index="{{index}}"></image>
          </view>
          <view class="related-cat-name">{{item.name}}</view>
          <view class="relation">{{relationMap[item.name]}}</view>
        </navigator>
      </view>
    </scroll-view>
  </view>
</view>


