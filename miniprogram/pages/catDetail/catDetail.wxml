<import src="../templates/common.wxml"/>
<view class="container1">
  <view class="image-container">
    <!-- 高度 {{height}} 由 JS 动态控制，必须保留内联样式；其余静态样式见 .detail-swiper -->
    <swiper
    data-_id="{{ cat._id }}"
    bindchange="bindChange"
    circular="true"
    indicator-dots="{{ true }}"
    indicator-color="#ffffff"
    indicator-active-color="#000000"
    current="{{parseInt(currentImageIndex)}}"
    class="detail-swiper"
    style="height: {{height}}"
    animation="{{animationData}}"
    >

    <block wx:for="{{photoArray}}" wx:key="*this">
        <swiper-item>
          <image
            lazy-load="true"
            src="{{imageUrls[index]}}"
            data-_id="{{ cat._id }}"
            data-index="{{index}}"
            bindlongpress="editCat"
            binderror="onSwiperImgError"
            mode="aspectFit"
            bindtap="previewImageHandler"
            class="swiper-item-image">
          </image>
          <view class="showNum">
    <text class="show-num-text">{{index+1}}/{{photoNum+1}}</text>
  </view>
        </swiper-item>
      </block>
  </swiper>
  </view>
</view>



<view class="cat-head">
  <!-- 猫咪大名（叠加全局 .cat-card）：收紧布局，状态胶囊紧贴其下。
       原 parent-view/itemname-box/name-spacer 固定宽高 + 负边距会把名字区撑出怪异空隙，已移除 -->
  <view class="cat-card cat-detail-name">{{ cat.name }}</view>
  <view class="status-container">
    <!-- 状态标签的背景色 {{bgcolor}} 由 JS 动态控制，必须保留内联样式 -->
    <view wx:if="{{cat.status}}" class="status-item" style="background-color: {{bgcolor}};">
      <view class="status-item-label">{{cat.status}}</view>
    </view>
    <!-- 绝育标签的背景色 {{bgcolor1}} 由 JS 动态控制，必须保留内联样式 -->
    <view wx:if="{{cat.isSterilization}}" class="status-item" style="background-color: {{bgcolor1}};">
      <view class="status-item-label">{{cat.isSterilization}}</view>
    </view>
  </view>
</view>

