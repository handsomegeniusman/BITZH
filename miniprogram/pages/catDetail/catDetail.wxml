</view>

<!-- 相关话题：聚合本猫出现在哪些推文话题里，带热度计数（有多少篇同标题文章）。
     点胶囊多选，选中后在本页内联展示这些话题的文章（不跳页）。
     个别猫话题过多 → 默认只显示前 8 个，可展开全部；真实猫名话题前加 🐱 猫头标识 -->
<view wx:if="{{relatedTopics.length}}" class="topic-section">
  <view class="topic-section-title">相关话题<text wx:if="{{selectedTopics.length}}" class="topic-section-selected">已选 {{selectedTopics.length}} 项</text></view>
  <!-- 全选 / 取消选择：一键操作，不用逐个点胶囊 -->
  <view class="topic-actions">
    <text class="topic-action-btn" bindtap="selectAllTopics">全选</text>
    <text class="topic-action-btn" bindtap="deselectAllTopics">取消选择</text>
  </view>
  <!-- 相关话题：默认一行横向滚动（前 8 个）；点"展开全部"后所有话题换行展示，可再"收起" -->
  <scroll-view wx:if="{{!topicsExpanded}}" class="topic-tags" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="topic-tags-inner">
      <view
        wx:for="{{relatedTopicsShow}}"
        wx:key="name"
        class="topic-chip {{topicSelectedMap[item.name] ? 'topic-chip-selected' : ''}}"
        bindtap="toggleTopic"
        data-name="{{item.name}}"
        data-id="{{item.catId}}"
      >
        <text wx:if="{{topicSelectedMap[item.name]}}" class="topic-check">✓</text>
        <text wx:if="{{item.isCat}}" class="topic-cat-icon">🐱</text>#{{item.name}}
        <text class="topic-count">{{item.count}}</text>
      </view>
    </view>
  </scroll-view>
  <!-- 展开后：全部话题换行展示（不再横向滚动） -->
  <view wx:else class="topic-tags-expanded">
    <view
      wx:for="{{relatedTopicsShow}}"
      wx:key="name"
      class="topic-chip {{topicSelectedMap[item.name] ? 'topic-chip-selected' : ''}}"
      bindtap="toggleTopic"
      data-name="{{item.name}}"
    >
      <text wx:if="{{topicSelectedMap[item.name]}}" class="topic-check">✓</text>
      <text wx:if="{{item.isCat}}" class="topic-cat-icon">🐱</text>#{{item.name}}
      <text class="topic-count">{{item.count}}</text>
    </view>
  </view>
  <!-- 展开/收起切换：话题数不超过 8 个时不需要 -->
  <view wx:if="{{relatedTopics.length > 8}}" class="topic-toggle" bindtap="toggleTopics">{{topicsExpanded ? '收起' : '展开全部'}}</view>
</view>

<!-- 排序选择器：胶囊样式 + 「排序」引导 + ▾ 箭头，让用户一眼知道可以点击切换（位于"展开全部"下方、推文列表上方） -->
<view wx:if="{{listData.length}}">
  <picker mode="multiSelector" bindchange="bindMultiPickerChange" value="{{multiIndex}}" range="{{multiArray}}">
    <view class="detail-picker">
      <text class="detail-picker-label">排序</text>
      <text class="detail-picker-value">{{multiArray[0][multiIndex[0]]}} {{multiArray[1][multiIndex[1]]}}</text>
      <text class="detail-picker-arrow">▾</text>
    </view>
  </picker>
</view>

<!-- 选中话题的文章：内联展示在详情页，不跳转。多选 = 多个话题的文章合并展示 -->
<view wx:if="{{selectedTopics.length}}" class="topic-articles">
  <view class="topic-articles-head">
    <view class="topic-articles-title">已选话题的文章</view>
    <view class="topic-articles-clear" bindtap="clearTopicFilter">清除选择</view>
  </view>
  <view wx:if="{{topicArticlesLoading}}" class="topic-articles-loading">加载中...</view>
  <block wx:elif="{{topicArticles.length}}">
    <view wx:for="{{topicArticles}}" wx:key="_id" class="topic-article-item">
      <template is="pageCard" data="{{item, urlPage, showTime: true}}"></template>
    </view>
  </block>
  <view wx:else class="topic-articles-empty">所选话题下暂无更多文章</view>
</view>

<view class="content">
  <view class="left">
    <block wx:for="{{listData}}" wx:key="_id" wx:for-item="item">
      <template is="pageCard" data="{{item, urlPage, showTime: false}}" wx:if="{{index%2==0}}"></template>
    </block>
  </view>
  <view class="right">
    <block wx:for="{{listData}}" wx:key="_id" wx:for-item="item">
      <template is="pageCard" data="{{item, urlPage, showTime: false}}" wx:if="{{index%2==1}}"></template>
    </block>
  </view>
</view>
