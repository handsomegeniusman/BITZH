<!-- 搜索关键词（nickname 由各字段自动生成、无需展示；隐藏避免超长文字溢出与下方删除按钮重叠） -->

<!-- 删除整只猫：严肃操作，放在内容末尾，需滚动到底部才会出现，避免吸底误触 -->
<button class="delete-cat-btn" bindtap="delete">删除整只猫</button>

<view class="bottom-pad"></view>

<!-- 吸底按钮条：提交 -->
<view class="bottom-bar">
  <button class="bar-btn primary reset-margin" bindtap="upload">确定提交</button>
</view>

<!-- 历史照片弹层：查看各编辑版本存档照片，点某张恢复为当前 -->
<view class="del-mask" wx:if="{{historyShow}}" catchtouchmove="noop" bindtap="closeHistory">
  <view class="del-modal history-modal" catchtap="noop">
    <view class="del-title">历史照片（已去重，标「已有」的不用再加）</view>
    <view class="history-hint">点某张加入图片（最前/最后），可拖动排序；提交后才生效</view>
    <scroll-view scroll-y class="history-scroll">
      <view wx:for="{{historyList}}" wx:key="time" class="history-version">
        <view class="history-meta">{{item.time}}　{{item.operator}}</view>
        <!-- 不用横向 scroll-view（避免 scroll-view 嵌套触发渲染层框架错误），flex 换行排列 -->
        <view class="history-photos">
          <view
            wx:for="{{item.photos}}"
            wx:for-item="photo"
            wx:key="url"
            class="history-photo-wrap"
            data-url="{{photo.url}}"
            data-has="{{photo.has}}"
            bindtap="insertHistoryPhoto"
          >
            <image class="history-photo" src="{{photo.url}}" mode="aspectFill" />
            <view wx:if="{{photo.has}}" class="history-has-badge">已有</view>
          </view>
        </view>
      </view>
    </scroll-view>
    <view class="del-btns">
      <button class="del-btn ok history-close" bindtap="closeHistory">关闭</button>
    </view>
  </view>
</view>

<!-- 跟随键盘的「完成」栏：键盘弹起时提供一键收起（部分输入法没有收起键） -->
<kb-done-bar/>

<!-- 隐私授权弹窗（相册/相机选图前按需弹出，含原生 agreePrivacyAuthorization 按钮） -->
<privacy-popup id="privacyPopup" desc="需要你的授权，才能从相册或相机中选择图片。是否同意？"/>