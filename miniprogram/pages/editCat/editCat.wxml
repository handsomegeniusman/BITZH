<view class="img-tip"><text user-select="true">照片</text><text class="req-star">*</text></view>
<!-- 图片区：横向拖拽排序（长按拖拽/单击预览/删除确认/设封面/末尾新增，全部在 image-sorter 组件内） -->
<image-sorter
  items="{{imageUrls}}"
  tip="{{imgTip}}"
  show-tools="{{true}}"
  show-add="{{true}}"
  invalid="{{formErrors.photo}}"
  bind:change="onImgChange"
  bind:add="getphoto"
/>
<view class="field-error" wx:if="{{formErrors.photo}}">请至少上传一张照片</view>

<!-- 历史照片：查看各编辑版本的存档照片，可挑一张恢复为当前 -->
<button class="history-btn" bindtap="loadHistory">历史照片</button>

<!-- 恢复上次数据：进入页面时已预检过该猫是否有修改历史，有才显示此按钮（图片下方、名字上方） -->
<button wx:if="{{restoreAvailable}}" class="restore-btn" bindtap="restoreLast">恢复上次数据</button>
<button wx:if="{{restoreVisible}}" class="restore-all-btn" bindtap="applyAllOld">全部使用上次数据</button>
<view class="restore-meta" wx:if="{{restoreVisible}}">上次修改时间：{{restoreTime}}｜编辑人：{{restoreEditor}}</view>

