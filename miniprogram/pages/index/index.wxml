<import src="../templates/common.wxml"/>

<view wx:if="{{blackNum}}">
  <template is="blackNumPopup" data="{{popupAnimation}}"/>
</view>
<view wx:else class="index-root">

  <view wx:if="{{showPopup}}">
    <template is="noticePopup" data="{{notice, popupAnimation}}"/>
  </view>

  <!-- 搜索框：按话题 / 标题 / 用户名 / 用户ID 搜索推文（同时并行搜猫名/绰号，展示猫横条） -->
  <view class="search-bar">
    <input
      class="search-input"
      value="{{search}}"
      bindinput="onSearchInput" show-confirm-bar="{{false}}"
      placeholder="🔍 搜索话题 / 标题 / 用户名"
      confirm-type="search"
      placeholder-class="search-placeholder"
    />
    <text wx:if="{{search}}" class="search-clear" bindtap="onSearchClear">×</text>
  </view>

  <!-- 猫横条：搜索命中猫（大名 / 绰号 / "X的妈妈或孩子"）时展示，点击直达猫详情 -->
  <view wx:if="{{search && catResults.length}}" class="cat-results">
    <view class="cat-results-title">猫咪</view>
    <view class="cat-bar" wx:for="{{catResults}}" wx:key="_id" bindtap="toCatDetail" bindlongpress="editCatFromSearch" data-_id="{{item._id}}">
      <image
        class="cat-bar-img"
        lazy-load="true"
        src="{{item._thumbFallback == 1 ? item._thumbJpg : (item._thumbFallback > 1 ? '/pages/images/logo.png' : item._thumbUrl)}}"
        binderror="onCatImgError"
        data-list="catResults"
        data-index="{{index}}"
      ></image>
      <view class="cat-bar-info">
        <view class="cat-bar-name">{{item.name}}</view>
        <view class="cat-bar-sub">{{item._sub}}</view>
      </view>
      <view class="cat-bar-arrow">›</view>
    </view>
  </view>

  <!-- 用户横条：仅管理员，搜索命中用户时展示，点击进用户管理页（可封禁/解封）。
       用户下方直接列出他发过的帖子，点击帖子可跳原文详情页看内容。 -->
  <view wx:if="{{isAdministrator && search && userResults.length}}" class="cat-results">
    <view class="cat-results-title">用户</view>
    <view wx:for="{{userResults}}" wx:key="_id" wx:for-item="user" class="user-search-block">
      <view class="cat-bar" bindtap="toUserManage" data-userid="{{user.userId}}" data-index="{{index}}">
        <image class="cat-bar-img" src="{{user.avatarUrl || defaultAvatar}}" binderror="onUserImgError" data-index="{{index}}" lazy-load="true"></image>
        <view class="cat-bar-info">
          <view class="cat-bar-name">{{user.nickName}}</view>
          <view class="cat-bar-sub">{{user.userId}}</view>
        </view>
        <view class="cat-bar-arrow">›</view>
      </view>
      <!-- 该用户的帖子列表：点击跳转原文详情页（仅管理员可见，含已下架的，标注 hidden） -->
      <view wx:if="{{user.posts && user.posts.length}}" class="user-post-list">
        <view class="user-post-row" wx:for="{{user.posts}}" wx:for-item="post" wx:key="_id" bindtap="toPostDetail" data-id="{{post._id}}">
          <text class="user-post-title">{{post.tittle}}</text>
          <text class="user-post-time">{{post.timeText}}</text>
          <text wx:if="{{post.hidden}}" class="post-badge">已下架</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 用户选择排序方式：搜索出猫后位于猫咪下方、文章上方（中间位置）；
       未搜索时猫横条不显示，即位于搜索框下方、文章上方 -->
  <view class="picker">
    <picker mode="multiSelector" bindchange="bindMultiPickerChange" value="{{multiIndex}}" range="{{multiArray}}">
      <view class="picker-inner">
        <text>{{multiArray[0][multiIndex[0]]}}-{{multiArray[1][multiIndex[1]]}}</text>
        <text class="picker-arrow">▾</text>
      </view>
    </picker>
  </view>

  <!-- 搜索空态：无猫也无推文也无用户才提示 -->
  <view wx:if="{{search && loaded && !listData.length && !catResults.length && !userResults.length}}" class="search-empty">没有找到相关内容，换个关键词试试</view>

  <!-- 审核模式（audit=false）下默认不显示小猫书内容；用户搜索时仍显示搜索结果 -->
  <view wx:if="{{audit || searchMode}}">
    <view class="content" >
      <view class="left">
        <block wx:for="{{leftList}}" wx:key="_id" wx:for-item="item">
          <template is="pageCard" data="{{item, urlPage, showTime: searchMode}}"></template>
        </block>
      </view>
      <view class="right">
        <block wx:for="{{rightList}}" wx:key="_id" wx:for-item="item">
          <template is="pageCard" data="{{item, urlPage, showTime: searchMode}}"></template>
        </block>
      </view>
    </view>
  </view>

<!-- 跟随键盘的「完成」栏：键盘弹起时提供一键收起（部分输入法没有收起键） -->
<kb-done-bar/>

</view>