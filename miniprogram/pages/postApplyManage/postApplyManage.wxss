/* 发布申请页样式
   —— 本项目的页面样式是**页面级**的，@import 在这里用不了（试过，不生效），
      所以这套卡片/头像/ID/按钮/密码行的词汇表是从 adminManage.wxss 整段抄过来的，
      保证两页观感一致。改按钮或卡片样式时，三处（userManage / adminManage / 本页）要一起改。
      多出来的只有 .status-bad（"已拒绝"徽标）。 */
.root {
  padding: 24rpx;
  box-sizing: border-box;
}

/* ---------- 身份提醒条（服务端未能独立确认身份时显示） ----------
   用醒目的黄底 + 深色字：这是要让人一眼看见的实话，不是装饰。
   故意不用红色 —— 红色在本项目里是"危险操作"(danger 按钮)，这里表达的是"提醒"。 */
.warn-bar {
  display: flex;
  flex-direction: column;
  background: #fff8e1;
  border: 1rpx solid #ffe0a3;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.warn-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #a86a00;
  margin-bottom: 8rpx;
}

.warn-text {
  font-size: 24rpx;
  color: #8a6d3b;
  line-height: 1.7;
}

/* ---------- 操作密码 ---------- */
.pwd-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pwd-input {
  flex: 1;
  font-size: 28rpx;
  padding: 12rpx 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.pwd-btn {
  flex-shrink: 0;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  color: #fff;
  background: #FF405E;
  border-radius: 8rpx;
}

.pwd-btn:active {
  opacity: 0.8;
}

.pwd-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
}

/* ---------- 通用卡片 / 空态 ---------- */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 80rpx 0;
}

.empty.small {
  padding: 24rpx 0;
  font-size: 24rpx;
  line-height: 1.6;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin: 8rpx 0 16rpx;
}

/* ---------- 用户头部（头像 + 昵称 + ID + 状态） ---------- */
.user-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.user-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #f0f0f0;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  word-break: break-all;
}

.user-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999;
  word-break: break-all;
}

.user-id-row {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
}

.user-id {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #999;
  word-break: break-all;
}

/* 复制按钮：带边框的胶囊 + 主色，与 userManage 同款（灰色小字没人看得出能点） */
.copy-btn {
  flex: none;
  margin-left: 12rpx;
  padding: 2rpx 18rpx;
  font-size: 22rpx;
  color: #FF405E;
  background: #fff;
  border: 1rpx solid #FF405E;
  border-radius: 999rpx;
}

.copy-btn:active {
  background: #FFE5EA;
}

/* ---------- 状态徽标 ---------- */
.user-status {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 24rpx;
}

.status-ok {
  background: #e8f8ee;
  color: #27ae60;
}

/* 「已拒绝」徽标。用灰色而不是红色：拒绝是正常的审批结果，不是出错或被处罚的状态 */
.status-bad {
  background: #f0f0f0;
  color: #888;
}

/* ---------- 操作行 ---------- */
.user-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f2f2f2;
}

/* 按钮说明文字：解释"为什么这个按钮是灰的"，免得用户以为是页面坏了 */
.actions-tip {
  flex: 1;
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
}

/* 这三个按钮用 view 而不是 button（userManage 用的是 button），
   所以内边距要自己给：button 自带默认内边距，view 没有 */
.btn {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  text-align: center;
  color: #fff;
  background: #FF405E;
  border-radius: 8rpx;
}

.btn.small {
  margin: 0;
}

.btn.success {
  background: #27ae60;
}

.btn.danger {
  background: #c0392b;
}

/* 禁态：灰底灰字。用 class 而不是 disabled 属性 ——
   disabled 的默认样式会和上面的 .btn 打架，且本仓库既有做法就是 class（userManage.wxml） */
.btn.done,
.btn-disabled {
  background: #e8e8e8;
  color: #aaa;
}

.btn:active {
  opacity: 0.85;
}
