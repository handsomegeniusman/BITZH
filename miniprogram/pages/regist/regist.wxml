<view wx:if="{{audit}}">
  <view class="page">
    <view class="card">
      <!-- 头像（选填）：必须用微信官方 open-type="chooseAvatar" 按钮——头像只能由用户点击原生触发，
           改用 wx.chooseAvatar 之类的 JS API 程序化调用会静默失效（点击完全没反应、且不报错）。
           bindtap 只做隐私授权前置：用户拒绝过隐私指引后原生入口会失效，同步拉起官方弹窗可恢复。 -->
      <button class="avatar-button" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar" bindtap="onAvatarTap">
      <image class="avatar-img" src="{{userInfo.avatarUrl}}" ></image>
      </button>
      <view class="avatar-tip">点头像可从微信选择，不选则使用默认头像</view>
      <view class="input-container">
        <text class="input-label">昵称：</text>
        <input type="nickname" class="input-field" placeholder="请输入昵称" value="{{userInfo.nickName}}" bindinput="onInput" show-confirm-bar="{{false}}"/>
      </view>
      <view class="input-container1">
        <view class="tip-message" wx:if="{{sameName}}">已重名，请修改昵称</view>
        <view class="tip-message1" wx:else></view>
      </view>
      <view class="input-container1" wx:if="{{forbidWord}}">
        <view class="tip-message-forbid">昵称不能含「{{forbidWord}}」等仿冒/误导词汇，请更换</view>
      </view>
      <view class="input-container2">
        <text class="input-label1">手机号：</text>
        <input type="text" class="input-field" value="{{userInfo.phoneNum}}" bindinput="onInput1" show-confirm-bar="{{false}}" placeholder="可不填"></input>
      </view>

    </view>
    <button class="submit-button" bindtap="upload">提交</button>
  </view>

  <!-- 跟随键盘的「完成」栏：键盘弹起时提供一键收起（部分输入法没有收起键） -->
  <kb-done-bar/>
</view>
