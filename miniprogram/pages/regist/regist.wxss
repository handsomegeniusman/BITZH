/* 2026-09-14 机型自适应：原来 .page 写死 height:100%、.card 写死 height:1000rpx，
   小屏 / 大字体 / 不同 rpx 换算的机型上内容会超出卡片高度，flex 子项被压缩，
   头像图就被挤到和下面「点击头像可从微信选择」的提示文字重叠。
   改成「按内容撑高 + 可滚动」：任何机型都不会重叠也不会被裁。 */
.page {
  background-color: #fff0f5;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0 240rpx; /* 底部留出悬浮「提交」按钮的位置 */
}

.card {
  display: flex;
  flex-direction: column; /* 子元素按照列排列 */
  min-height: 900rpx; /* 只做最小高度兜底，不再写死高度：内容多就自然撑高 */
  box-sizing: border-box;
  padding: 60rpx;
  background-color: #fff;
  border-radius: 10rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  position: relative;
  margin: 40rpx; /* 调整与页面边缘之间的间距 */
}

.avatar-container {
  margin-bottom: 60rpx; /* 调整头像容器与输入框容器之间的距离 */
  position: relative;
}

/* 2026-09-15 头像改圆形：原来 360×320rpx 的长方形太大，且图片只占 80%。
   圆形必须先方后圆 —— 宽高必须相等，border-radius:50% 才是个正圆而不是椭圆。
   240rpx ≈ 120px，是常见的资料页头像尺寸。 */
.avatar-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none; /* 关键：不参与 flex 收缩，内容变高时头像框也不会被压扁 */
  align-self: center; /* 原来靠 top:80rpx 定位，但没写 position，是无效属性，改回居中 */
  width: 240rpx;
  height: 240rpx; /* 与宽度相等，配合 50% 圆角才是正圆 */
  padding: 0;
  overflow: hidden; /* 图片严格裁在圆内，不会溢出压到下面的提示文字 */
  border-radius: 50%;
  background-color: #f6daff;
}
/* 去掉 button 自带的 1px 描边（::after 会继承 border-radius，变成环在头像上的一圈灰线） */
.avatar-button::after {
  border: none;
}

/* 图片铺满整个圆形按钮：再靠按钮的 border-radius + overflow:hidden 裁成圆。
   配合 wxml 上的 mode="aspectFill"，非正方形的头像会被裁掉四边而不是被拉扁。 */
.avatar-img {
  display: block;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
}

/* 2026-09-14 提示文字紧跟头像框，间距固定 24rpx：
   原来 116rpx 是为了「躲开」溢出压下来的头像图，属于治标；根因（卡片写死高度）已在上方修掉 */
.avatar-tip {
  flex: none;
  margin-top: 24rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #999;
  text-align: center;
}

.input-container {
  display: flex;
  align-items: center;
  margin-top: 90rpx; /* 调整输入框容器与头像容器之间的距离（原 180rpx，让出「头像选填」提示的高度） */
  margin-left: -30rpx;
}

.input-container1 {
  display: flex;
  margin-top: 20rpx;
  align-items: center;
  margin-left: 190rpx;
}

.input-container2 {
  display: flex;
  align-items: center;
  margin-top: 40rpx; /* 调整输入框容器与头像容器之间的距离 */
  margin-left: -30rpx;
}

.input-label {
  font-size: 32rpx;
  font-weight: bold;
  text-align: right;
  margin-right: 40rpx;
  width: 160rpx;
}

.input-label1 {
  font-size: 32rpx;
  font-weight: bold;
  text-align: right;
  margin-right: 30rpx;
  width: 170rpx;
}

.tip-message {
  height: 40rpx;
  color: red;
  font-size: 28rpx;
}

.tip-message1 {
  height: 40rpx;
  width: 100%;
}

/* 昵称含禁用词（官方/北理珠关爱部等仿冒词）的提示：允许换行，不裁剪 */
.tip-message-forbid {
  min-height: 40rpx;
  color: red;
  font-size: 28rpx;
  line-height: 1.4;
}

  

/* 2026-09-15 输入框文字垂直居中 + 不再裁字：
   原来只写了 padding:10rpx 20rpx，没有高度也没有 line-height —— input 的盒子高度
   由内容行高决定，字号 32rpx 时盒子刚好卡住字形，字母的上下端（g/y/p 的尾巴、
   拼音声调）就被切掉一截，看着就是「文字没居中、字母显示不全」。
   改成「显式高度 + 同值 line-height + border-box」：盒高固定 76rpx，行高也是 76rpx，
   文字上下各留白、稳定居中，任何机型 / 系统字体大小下都不会再被裁。
   注意：纵向留白已由 height 接管，所以 padding 只留左右，否则行高会溢出盒子。 */
.input-field {
  flex: 1;
  min-width: 0; /* 允许在 label 固定宽度的行里正常收缩，不会把输入框顶出卡片 */
  height: 76rpx;
  line-height: 76rpx;
  box-sizing: border-box;
  font-size: 32rpx;
  padding: 0 20rpx;
  border: none;
  border-radius: 4rpx;
  outline: none;
  background-color: #fff5ee;
  color: #000000;
}

.submit-button {
  display: flex;
  justify-content: center;
  align-items: center;
  position: absolute;
  bottom: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 80vw;
  height: 100rpx;
  border-radius: 25rpx;
  background-color: #FF405E;
  color: white;
  font-size: 40rpx;
  font-weight: bold;
  border: none;
  outline: none;
  box-shadow: 4rpx 4rpx 16rpx rgba(0, 0, 0, 0.3);
}
