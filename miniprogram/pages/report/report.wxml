<view class="root">
  <view class="card">
    <view class="label">被举报内容</view>
    <view class="content">{{content || '（无内容快照）'}}</view>
  </view>

  <view class="card">
    <view class="label">常见举报类型 <text class="hint">（点选自动填入）</text></view>
    <view class="reason-tags">
      <text class="reason-tag" wx:for="{{reasonTags}}" wx:key="*this" data-tag="{{item}}" bindtap="onReasonTag">{{item}}</text>
    </view>
  </view>

  <view class="card">
    <view class="label">举报理由 <text class="hint">（必填，200字以内）</text></view>
    <textarea class="textarea" maxlength="200" placeholder="可点上方类型快速填入，再补充具体细节（如哪句话、哪个账号等）" bindinput="onReasonInput" value="{{reason}}" />
  </view>

  <view class="tip">举报为匿名，你的身份不会泄露给被举报人。管理员会尽快核实，恶意刷举报将被限制。</view>

  <button class="btn" bindtap="submit" disabled="{{submitting}}">提交举报</button>
</view>
