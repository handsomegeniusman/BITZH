.root {
  padding: 24rpx;
  box-sizing: border-box;
}

.quick-ban {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 24rpx;
}

.quick-ban-input {
  flex: 1;
  font-size: 26rpx;
  padding: 8rpx 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.quick-ban-btn {
  flex-shrink: 0;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
}

.tab.active {
  color: #FF405E;
  font-weight: bold;
  border-bottom: 4rpx solid #FF405E;
}

.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 80rpx 0;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.meta {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.reason {
  font-size: 26rpx;
  color: #FF405E;
  margin-bottom: 8rpx;
}

.content {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
  margin-bottom: 8rpx;
}

.author {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
  word-break: break-all;
}

.actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.btn {
  background: #FF405E;
  color: #fff;
  border-radius: 8rpx;
}

.btn.small {
  margin: 0;
}

.btn.warn {
  background: #ff9500;
}

.btn.danger {
  background: #c0392b;
}

.btn.success {
  background: #27ae60;
}
