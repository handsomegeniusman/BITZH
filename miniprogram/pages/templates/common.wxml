<!--
  公共 WXML 模板
  使用方式：在页面 wxml 顶部加 <import src="../templates/common.wxml"/>
          然后用 <template is="模板名" data="{{...}}"/> 引用
-->

<!-- 黑名单弹窗：index / catSearch / about / mydetail 共用。
     不可关闭、无背景点击关闭，只留「去申诉」出口（误封申诉通道必须有）。
     正常情况下黑名单用户会被各 tab 页 reLaunch 到 banned 全屏页，此弹窗为兜底。 -->
<template name="blackNumPopup">
  <view class="popup-background" id="popup-background"></view>
  <view class="popup" animation="{{popupAnimation}}">
    <text class="title1">无法访问</text>
    <view>
      <text class="notice_content" decode="{{true}}">&emsp;&emsp;你已被禁止访问此小程序。&emsp;&emsp;</text>
    </view>
    <view class="notice_content">如认为属于误封，可提交申诉。</view>
    <button class="close-button" bindtap="goAppeal">去申诉</button>
  </view>
</template>

<!-- 公告弹窗：index / catSearch 共用 -->
<template name="noticePopup">
  <view class="popup-background" id="popup-background" bindtap="hidePopup"></view>
  <view class="popup" animation="{{popupAnimation}}">
    <text class="title1">公告</text>
    <view>
      <text class="notice_content" decode="{{true}}">&emsp;&emsp;{{notice}}&emsp;&emsp;</text>
    </view>
    <button class="close-button" bindtap="closePopup">关闭</button>
  </view>
</template>

<!-- 推文卡片：index / catDetail 共用。
     数据要求：urlPage, item (含 _id, tittle, authorImg, author, authorId, good)
     事件要求：toBookletDetail, editBooklet, showAuthorImg, toName, giveGood
     可选：showTime=true 时在标题下居中显示时间（首页瀑布流不传 → 不显示） -->
<template name="pageCard">
  <view class="li">
    <view bindtap="toBookletDetail" bindlongpress="editBooklet" data-_id="{{item._id}}" data-authorid="{{item.authorId}}">
      <image lazy-load="true" class="pic" src="{{item.officialLogo ? '/pages/images/logo.png' : urlPage + item.tittle + '0.jpg'}}" mode="widthFix"></image>
      <view class="title-wrap">
        <navigator class="title">{{item.tittle}}</navigator>
      </view>
      <text class="page-time" wx:if="{{showTime && item._timeText}}">{{item._timeText}}</text>
    </view>
    <view class="bottom">
      <view class="toux-name">
        <image class="toux" lazy-load="true" src="{{item.authorImg}}" mode="aspectFill" bindtap="showAuthorImg" data-authorimg="{{item.authorImg}}"></image>
        <text class="name" bindtap="toName" data-author="{{item.author}}">{{item.author}}</text>
      </view>
      <view class="love" wx:if="{{item.good !== undefined}}">
        <image class="toux" lazy-load="true" src="/pages/images/爱心.png" bindtap="giveGood" data-_id="{{item._id}}" data-good="{{item.good}}" data-index="{{item._i}}"></image>
        <text class="love-num" bindtap="giveGood" data-_id="{{item._id}}" data-good="{{item.good}}" data-index="{{item._i}}">{{item.good}}</text>
      </view>
    </view>
  </view>
</template>
